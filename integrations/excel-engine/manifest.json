{
  "id": "unexpected.excel-engine",
  "name": "uneXpected Excel Engineering Engine",
  "version": "0.1.1",
  "status": "source-integration",
  "scope": "general-purpose-cross-industry",
  "engine": {
    "name": "Excelize",
    "module": "github.com/xuri/excelize/v2",
    "version": "v2.11.1-0.20260805032953-db93f8d89de7",
    "releaseTag": null,
    "releaseCommit": "db93f8d89de71589069a54d1b998af02e3c5f7cd",
    "license": "BSD-3-Clause",
    "goVersion": "1.25.0"
  },
  "operations": [
    "inspect-xlsx-streaming",
    "generate-xlsx"
  ],
  "limits": {
    "uploadBytes": 20971520,
    "zipEntries": 4096,
    "unzipBytes": 67108864,
    "xmlPartBytes": 8388608,
    "sheets": 20,
    "rowsPerSheet": 50000,
    "columnsPerSheet": 100,
    "previewRows": 20,
    "jsonRequestBytes": 1048576,
    "workerTimeoutMs": 30000
  },
  "security": {
    "zip64Preflight": true,
    "sharedStringIndexPreflight": true,
    "duplicateZipEntryRejection": true,
    "exposedMethods": [
      "ZIP metadata preflight",
      "streaming worksheet rows",
      "cell value reads",
      "new workbook generation"
    ],
    "excludedMethods": [
      "pivot table retrieval",
      "slicer retrieval",
      "conditional format retrieval",
      "decryption",
      "formula calculation",
      "column mutation"
    ],
    "fixedAdvisories": [
      "CVE-2026-107224 / GHSA-fw94-4wwp-w8pw"
    ],
    "note": "Pinned Excelize pseudo-version includes the upstream Zip64 size fix. Independent ZIP preflight remains defense-in-depth. Other upstream advisories must be assessed against the exact exposed methods and dependency revision before production."
  },
  "api": {
    "inspect": "POST /excel/inspect (raw .xlsx body, bearer-authenticated)",
    "generate": "POST /excel/generate (JSON WorkbookSpec, bearer-authenticated; returns .xlsx bytes)"
  },
  "routing": {
    "excelize": "Server-side .xlsx inspection, structured generation and bounded streaming reads",
    "vba": "Desktop Excel object-model automation only",
    "macroFree": "Prefer formulas, tables and Power Query when macros are unnecessary"
  },
  "verification": {
    "goTests": "CI go test ./...",
    "nodeIntegrationTests": "CI node --test test/excel-engine.test.mjs",
    "excelDesktop": "not executed by this server-side integration",
    "nodeProviderToolRoundTrips": "CI mocked OpenAI and Anthropic native tool loops; live provider calls require configured credits and separate test"
  }
}
